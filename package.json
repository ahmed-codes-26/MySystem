{
  "name": "mysystem",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace client",
    "start": "node server/src/index.js",
    "test": "node --test client/tests/*.test.js server/tests/*.test.js",
    "test:finance": "node --test server/tests/finance.test.js server/tests/financeValidation.test.js",
    "test:finance:integration": "node server/tests/financeIntegration.js",
    "seed": "node server/src/seed.js",
    "hash-password": "node server/src/hashPassword.js",
    "test:integration": "node server/tests/integration.js",
    "test:security": "node server/tests/securityIntegration.js",
    "vault:migrate": "node server/src/migrateVaultEncryption.js"
  }
}
